// PROGRAMA PRINCIPAL
PROGRAMA, JNS CAPTURAR_SELECT
JNS SWITCH
JUMP PROGRAMA


CAPTURAR_SELECT, HEX 000
    INPUT
    STORE SELECT
    JUMPI CAPTURAR_SELECT


SWITCH, HEX 000
    // CASO 1: PINTAR EN HORIZONTAL
    LOAD SELECT 
    SUBT UNO 
    SKIPCOND 400
    JUMP CASO2
    JNS FUNCION_A
    JUMPI SWITCH
    
    // CASO 2: PINTAR EN VERTICAL
    CASO2, LOAD SELECT   
    SUBT DOS 
    SKIPCOND 400
    JUMP CASO3
    JNS FUNCION_B
    JUMPI SWITCH
    
    // CASO 3: PASO A LA DERECHA
    CASO3, LOAD SELECT 
    SUBT TRES
    SKIPCOND 400
    JUMP CASO4
    
    JUMPI SWITCH
    
    // CASO 4: Salir
    CASO4, LOAD SELECT  
    SUBT CUATRO
    SKIPCOND 400
    JUMPI SWITCH
    HALT
    


PINTAR, HEX 000
        LOAD COLOR
		STOREI D_PTR
		JUMPI PINTAR

/subrutina para pintar horizontal
P_HORIZONTAL, HEX 000
              Clear
              STORE I
	PH_FOR,   LOAD I
	          SUBT N16
	          SKIPCOND 0C00 / i < 16
			  JUMPI P_HORIZONTAL
			  JNS PINTAR
			  LOAD D_PTR
			  ADD N1
			  STORE D_PTR
			  LOAD I
			  ADD N1
			  STORE I
			  JUMP PH_FOR

/SUBRUTINA PARA PINTAR VERTICAL
P_VERTICAL, HEX 000
            CLEAR
			STORE J
PV_FOR,     LOAD J
            SUBT N16
			SKIPCOND 0C00 / i < 16
			JUMPI P_VERTICAL
			JNS PINTAR
			LOAD D_PTR
			ADD N16
			STORE D_PTR
			LOAD J
			ADD N1
			STORE J
			JUMP PV_FOR

/FUNCION A
FUNCION_A, HEX 000
           CLEAR 
		   STORE J
FOR_A,     LOAD J
           SUBT N8
		   SKIPCOND 0C00 / j < 8
		   JUMPI FUNCION_A
		   LOAD ROJO
		   STORE COLOR
		   JNS P_HORIZONTAL
		   LOAD AZUL
		   STORE COLOR
		   JNS P_HORIZONTAL
		   LOAD J
		   ADD N1
		   STORE J
		   JUMP FOR_A

/FUNCION B
FUNCION_B, HEX 000
           CLEAR 
		   STORE I
FOR_B,     LOAD I
           SUBT N8
		   SKIPCOND 0C00 / i < 8
		   JUMPI FUNCION_B
		   LOAD D_BASE
		   STORE D_PTR
		   LOAD ROJO
		   STORE COLOR
		   JNS P_VERTICAL
		   LOAD D_BASE
		   ADD N1
		   STORE D_BASE
		   STORE D_PTR
		   LOAD AZUL
		   STORE COLOR
		   JNS P_VERTICAL
		   LOAD D_BASE
		   ADD N1
		   STORE D_BASE
		   LOAD I
		   ADD N1
		   STORE I
		   JUMP FOR_B
		   
           

/SUBRUTINA PINTAR
COLOR, HEX 0000
I_P, DEC 0

D_BASE, HEX 0F00
BASE, HEX 0F00
D_FIN, HEX 0FFF
D_PTR, HEX 0F00
/R: X111 1100 0000 0000  -> HEX 7C00
/G: X000 0011 1110 0000  -> HEX 03E0
/B: X000 0000 0001 1111  -> HEX 001F
ROJO, HEX 7C00
VERDE, HEX 03E0
AZUL, HEX 001F
N16, DEC 16
N1, DEC 1
N2, DEC 2
N8, DEC 8
I, DEC 0
J, DEC 0
SELECT, DEC 0
UNO, DEC 1
DOS, DEC 2
TRES, DEC 3
CUATRO, DEC 4